annotate("text", x = lower_bound - 400, y = 0.001,
label = paste("μ-2σ =", round(lower_bound, 2)),
color = "red", size = 3) +
annotate("text", x = upper_bound + 400, y = 0.001,
label = paste("μ+2σ =", round(upper_bound, 2)),
color = "red", size = 3) +
labs(title = "Histogram with 2 SD boundaries",
x = "Weight (grams)",
y = "Density") +
theme_minimal()
