library(nhanesA)                  # NHANES Data
library(tidyverse)                # Cleaning/Combining Data
library(janitor)                  # Cleaning Data
library(naniar)                   # Missing Values Package
library(mice)                     # Multivariate Imputation by Chained Equations
library(survey)
library(mitools)
demo_raw            <- nhanes("P_DEMO")     # Demographics (Sex, Age, Race)
demo_raw            <- nhanes("P_DEMO")     # Demographics (Sex, Age, Race)
exam_raw            <- nhanes("P_BMX")      # BMI data
#===================================
# File : Data_Cleaning_01
# Date : 08/05/2026 - 08/08/2026
# Author : Jonathan Donovan
#===================================
#===========================
# Loading Libraries
#===========================
library(nhanesA)                  # NHANES Data
library(tidyverse)                # Cleaning/Combining Data
library(janitor)                  # Cleaning Data
library(naniar)                   # Missing Values Package
library(mice)                     # Multivariate Imputation by Chained Equations
library(survey)
library(mitools)
#===========================
# Joining Selected Variables
# From NHANES 2017-2020
#===========================
demo_raw            <- nhanes("P_DEMO")     # Demographics (Sex, Age, Race)
exam_raw            <- nhanes("P_BMX")      # BMI data
c_protein_raw       <- nhanes("P_HSCRP")    # High-Sensitivity C-Reactive Protein
insulin_raw         <- nhanes("P_INS")      # Insulin data
glucose_raw         <- nhanes("P_GLU")      # Glucose levels
glycohemoglobin_raw <- nhanes("P_GHB")      # Glycohemoglobin
data_joined <- demo_raw %>%
left_join(exam_raw,            by = "SEQN") %>%
left_join(c_protein_raw,       by = "SEQN") %>%
left_join(insulin_raw,         by = "SEQN") %>%
left_join(glucose_raw,         by = "SEQN") %>%
left_join(glycohemoglobin_raw, by = "SEQN") %>%
clean_names() %>%
select(seqn,
riagendr, ridageyr, ridreth3,          # Demographics
wtmecprp, sdmvstra, sdmvpsu,           # Survey Weights
bmxbmi, lbxhscrp, lbxglu, lbxgh, lbxin # Biomarkers
) %>%
filter(ridageyr >= 16) %>%                    # Adults >= 16
filter(!is.na(lbxglu)) %>%                    # Restrict to participants with fasting glucose data
filter(!is.na(bmxbmi)) %>%                    # Drop missing dependent variable
mutate(
sex             = factor(riagendr),
race            = factor(ridreth3),
age             = as.numeric(ridageyr),
c_protein       = as.numeric(lbxhscrp),
bmi             = as.numeric(bmxbmi),
glycohemoglobin = as.numeric(lbxgh),
glucose         = as.numeric(lbxglu),
insulin         = as.numeric(lbxin)
) %>%
select(-riagendr, -ridreth3, -ridageyr,
-bmxbmi, -lbxhscrp, -lbxglu, -lbxgh, -lbxin)  # remove duplicates
data_joined <- demo_raw %>%
left_join(exam_raw,            by = "SEQN") %>%
left_join(c_protein_raw,       by = "SEQN") %>%
left_join(insulin_raw,         by = "SEQN") %>%
left_join(glucose_raw,         by = "SEQN") %>%
left_join(glycohemoglobin_raw, by = "SEQN") %>%
clean_names() %>%
select(seqn,
riagendr, ridageyr, ridreth3,          # Demographics
wtmecprp, sdmvstra, sdmvpsu,           # Survey Weights
bmxbmi, lbxhscrp, lbxglu, lbxgh, lbxin # Biomarkers
) %>%
filter(ridageyr >= 16) %>%                    # Adults >= 16
filter(!is.na(lbxglu)) %>%                    # Restrict to participants with fasting glucose data
filter(!is.na(bmxbmi)) %>%                    # Drop missing dependent variable
mutate(
sex             = factor(riagendr),
race            = factor(ridreth3),
age             = as.numeric(ridageyr),
c_protein       = as.numeric(lbxhscrp),
bmi             = as.numeric(bmxbmi),
glycohemoglobin = as.numeric(lbxgh),
glucose         = as.numeric(lbxglu),
insulin         = as.numeric(lbxin)
) %>%
select(-riagendr, -ridreth3, -ridageyr,
-bmxbmi, -lbxhscrp, -lbxglu, -lbxgh, -lbxin)  # remove duplicates
glycohemoglobin_raw <- nhanes("P_GHB")      # Glycohemoglobin
data_joined <- demo_raw %>%
left_join(exam_raw,            by = "SEQN") %>%
left_join(c_protein_raw,       by = "SEQN") %>%
left_join(insulin_raw,         by = "SEQN") %>%
left_join(glucose_raw,         by = "SEQN") %>%
left_join(glycohemoglobin_raw, by = "SEQN") %>%
clean_names() %>%
