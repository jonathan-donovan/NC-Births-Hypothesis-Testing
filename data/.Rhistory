imputation_step1 <- data_joined %>%
select(seqn, wtmecprp, sdmvstra, sdmvpsu, bmi, insulin,
glucose, c_protein, glycohemoglobin, age, sex, race)
# Using predictive Mean Matching
imputation_step2 <- mice(imputation_step1, maxit = 0)
imputation_method <- imputation_step2$method
imputation_method[c("seqn", "wtmecprp", "sdmvstra", "sdmvpsu", "bmi",
"age", "sex", "race")] <- ""
imputated_data <- mice(imputation_step1, m = 5, method = imputation_method, seed = 123)
# Plotting Data (only uses 1 of the 5 PMMs from mice)
clean_dataframe <- complete(imputated_data, action = 1)   # Dataframe for plots
summary(clean_dataframe)
miss_var_summary(clean_dataframe)
# Models Base (using PPM 1 from mice)
nhanes_design <- svydesign(
id      = ~sdmvpsu,
strata  = ~sdmvstra,
weights = ~wtmecprp,
nest    = TRUE,
data    = clean_dataframe
)
clean_model1 <- svyglm(
bmi ~ glucose + c_protein + glycohemoglobin + insulin + age + sex + race,
design = nhanes_design
)
# Rest of models
clean_model2 <- svyglm(
bmi ~ glucose + c_protein + glycohemoglobin + insulin + age + sex + race,
design = svydesign(
id      = ~sdmvpsu,
strata  = ~sdmvstra,
weights = ~wtmecprp,
nest    = TRUE,
data    = complete(imputated_data, action = 2)
))
clean_model3 <- svyglm(
bmi ~ glucose + c_protein + glycohemoglobin + insulin + age + sex + race,
design = svydesign(
id      = ~sdmvpsu,
strata  = ~sdmvstra,
weights = ~wtmecprp,
nest    = TRUE,
data    = complete(imputated_data, action = 3)
))
clean_model4 <- svyglm(
bmi ~ glucose + c_protein + glycohemoglobin + insulin + age + sex + race,
design = svydesign(
id      = ~sdmvpsu,
strata  = ~sdmvstra,
weights = ~wtmecprp,
nest    = TRUE,
data    = complete(imputated_data, action = 4)
))
clean_model5 <- svyglm(
bmi ~ glucose + c_protein + glycohemoglobin + insulin + age + sex + race,
design = svydesign(
id      = ~sdmvpsu,
strata  = ~sdmvstra,
weights = ~wtmecprp,
nest    = TRUE,
data    = complete(imputated_data, action = 5)
))
# Listing models
models_list <- list(clean_model1,
clean_model2,
clean_model3,
clean_model4,
clean_model5)
coef_list <- lapply(models_list, coef)
var_list <- lapply(models_list, vcov)
pooled_results <- MIcombine(results = coef_list, variances = var_list)
summary(pooled_results)
imputation_predictor_matrix <- imputation_step2$predictorMatrix
imputation_predictor_matrix[c("seqn","wtmecprp","sdmvstra","sdmvpsu")]<-0
imputated_data <- mice(imputation_step1,
m = 5,
method = imputation_method,
predictorMatrix = pred_matrix,
seed = 123)
